```gitignore
# Java compiled output
out/
target/
*.class

# Maven wrapper and project files should remain tracked
# Do not ignore pom.xml or mvnw files

# IntelliJ IDEA
.idea/
*.iml

# Visual Studio Code
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
*.log
```
